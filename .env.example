# No real values belong in this file or in any committed .env file.

# Required. Path to the RS256 signing key: an unencrypted PKCS#8 PEM ("BEGIN PRIVATE KEY"),
# RSA, at least 2048 bits. The service refuses to start if it is unset or unreadable.
# Never commit the key itself; see the README's "Development" section to generate one.
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key

# Required. The JDBC URL of the PostgreSQL instance, pointing at the auth schema
# (07-api and deployment.md §6). The service never runs migrations: synkro-auth-db owns the schema.
SPRING_DATASOURCE_URL=jdbc:postgresql://synkro-db:5432/synkro?currentSchema=auth_schema

# Required, and it must be auth_app: the service refuses to start as any other user
# (never auth_reader, never an administrator).
SPRING_DATASOURCE_USERNAME=auth_app

# Required: exactly one of the next two. Neither is set here, because the password is a secret.
# Prefer the file (a mounted secret, like the signing key); the plain variable suits local runs.
# SPRING_DATASOURCE_PASSWORD_FILE=/run/secrets/auth_app_password
# SPRING_DATASOURCE_PASSWORD=

# Optional. Access token lifetime as an ISO-8601 duration (default PT1H, per 07-api/authentication.md).
# SYNKRO_AUTH_ACCESS_TOKEN_TTL=PT1H

# Optional. Refresh token lifetime as an ISO-8601 duration (default P7D, per 07-api/authentication.md).
# SYNKRO_AUTH_REFRESH_TOKEN_TTL=P7D

# Tests only. When TEST_DATABASE_URL is set, the *IntegrationTest classes run against that database,
# connecting as auth_app (override with TEST_DATABASE_USER). Unset, they are skipped.
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/synkro
# TEST_DATABASE_PASSWORD=
