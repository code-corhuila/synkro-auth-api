# No real values belong in this file or in any committed .env file.

# Required. Path to the RS256 signing key: an unencrypted PKCS#8 PEM ("BEGIN PRIVATE KEY"),
# RSA, at least 2048 bits. The service refuses to start if it is unset or unreadable.
# Never commit the key itself; see the README's "Development" section to generate one.
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key

# Optional. Access token lifetime as an ISO-8601 duration (default PT1H, per 07-api/authentication.md).
# SYNKRO_AUTH_ACCESS_TOKEN_TTL=PT1H
